#!/usr/bin/env bash
# Animicro pre-push hook: rebuild the release ZIP before push.
# Configure once with: git config core.hooksPath .githooks  (handled by pnpm postinstall)

set -e

ROOT="$(git rev-parse --show-toplevel)"

echo "==> pre-push: rebuilding Animicro release ZIP..."
bash "$ROOT/scripts/build.sh"

if ! git diff --quiet release/ 2>/dev/null; then
    echo ""
    echo "⚠  release/ changed during build. Commit or stash the new ZIP if you want it tracked."
fi

exit 0
